{
  "name": "mech-tide",
  "private": true,
  "version": "0.12.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:pages": "GH_PAGES=1 vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playtest": "PLAYTEST_REPORT=1 vitest run tests/playtest.test.ts --reporter=dot",
    "playtest:balance": "PLAYTEST_EXPERIMENTS=1 vitest run tests/playtest.test.ts --reporter=dot",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#0a0f1c' --splashBackgroundColor '#0a0f1c'"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "phaser": "^3.87.0",
    "posthog-js": "^1.386.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
